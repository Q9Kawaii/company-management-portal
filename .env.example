# Copy this file to .env and fill in your Supabase project values.
# Find them in the Supabase dashboard under Project Settings -> API.
# Never put the service_role key here: VITE_* variables are bundled into the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
